{
  "name": "@lobehub/assets",
  "version": "0.0.0",
  "private": true,
  "description": "Logo assets, favicons, webfonts for LobeHub",
  "keywords": [
    "logo",
    "favicon",
    "webfont"
  ],
  "homepage": "https://github.com/lobehub/lobe-assets",
  "bugs": {
    "url": "https://github.com/lobehub/lobe-assets/issues/new"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lobehub/lobe-assets.git"
  },
  "license": "MIT",
  "author": "LobeHub <i@lobehub.com>",
  "sideEffects": false,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:favicons": "real-favicon generate src/favicons/faviconDescription.json packages/assets-favicons/assets/faviconData.json packages/assets-favicons/assets",
    "build:logo": "node src/logo/index.js",
    "build:webfonts": "node src/webfonts/index.js",
    "lint": "eslint \"{src,packages}/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:md": "remark . --quiet --frail --output",
    "lint:style": "stylelint \"{src,packages}/**/*.{js,jsx,ts,tsx}\" --fix",
    "prepare": "husky",
    "prettier": "prettier -c --write --no-error-on-unmatched-pattern \"**/**\"",
    "release": "multi-semantic-release",
    "release:local": "multi-semantic-release --no-ci",
    "test": "real-favicon check-for-update --fail-on-update packages/assets-favicons/assets/faviconData.json"
  },
  "lint-staged": {
    "*.md": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.json": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx}": [
      "prettier --write",
      "stylelint --fix",
      "eslint --fix"
    ],
    "*.{ts,tsx}": [
      "prettier --parser=typescript --write",
      "stylelint --fix",
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@lobehub/lint": "^1.26.3",
    "@qiwi/multi-semantic-release": "^7.1.2",
    "@types/node": "^22.19.20",
    "cli-real-favicon": "^0.0.9",
    "commitlint": "^18.0.0",
    "eslint": "^8.57.1",
    "favicons": "^7.3.0",
    "fontmin": "^1.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "semantic-release": "^21.1.2",
    "sharp": "^0.30",
    "stylelint": "^15.11.0",
    "svgo": "^4.0.1",
    "typescript": "^6.0.3",
    "unicode-emoji-json": "^0.9.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "gitmoji": {
    "capitalizeTitle": false
  }
}
